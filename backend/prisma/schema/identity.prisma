enum StaffRole {
  SUPER_ADMIN
  HQ_STAFF
  BRANCH_STAFF
  TEACHER
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffs        Staff[]
  students      Student[]
  classSessions ClassSession[]

  @@index([code])
}

model Staff {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String?   @db.Uuid
  createdById  String?   @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdBy     Staff?  @relation("StaffCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdStaffs Staff[] @relation("StaffCreator")

  classSessionsAsTeacher ClassSession[] @relation("ClassSessionTeacher")

  bookingsCreated Booking[] @relation("BookingCreatedBy")
  bookingsMarked  Booking[] @relation("BookingMarkedBy")

  creditLedgersCreated StudentCreditLedger[] @relation("CreditLedgerCreatedBy")
  attendanceAuditLogs  AttendanceAuditLog[]  @relation("AttendanceActor")

  @@index([branchId])
  @@index([role])
  @@index([isActive])
}
